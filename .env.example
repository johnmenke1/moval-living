# =============================================================================
# MovaL Living — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` (it's already in .gitignore).
# NEVER paste real secrets into chat, PRs, or screenshots.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Neon Postgres connection string.
# Get it from: https://console.neon.tech → your project → Connection Details
# Local dev: the "Pooled" connection string is fine.
DATABASE_URL=

# --- Google Maps ------------------------------------------------------------
# Public browser key for the Maps JavaScript API.
# Get it from: https://console.cloud.google.com → APIs & Services → Credentials
# Restrictions to set on the key:
#   - Application restrictions: HTTP referrers
#     - http://localhost:3000/*
#     - https://moval.living/*
#     - https://*.vercel.app/*
#   - API restrictions: Maps JavaScript API, Places API (if used)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Auth (NextAuth / Auth.js) ---------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the deployed site (used for callback URLs).
AUTH_URL=http://localhost:3000

# --- Email (passwordless login + notifications) ----------------------------
# Pick ONE provider. AWS SES is recommended for production.
# --- Option A: AWS SES ---
SES_REGION=us-east-2
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=hello@moval.living

# --- Option B: Resend (simpler, free tier available) -----------------------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=hello@moval.living

# --- Bot protection (Cloudflare Turnstile) -----------------------------------
# Every public form on moval.living that could send email via SES is gated by
# Turnstile — without this, attackers can POST to /api/claim/request etc. and
# use our SES identity as an open mail relay (Amazon abuse reports started
# 2026-09-15). Get keys from:
#   https://dash.cloudflare.com → Turnstile → your site
# If either is unset, all Turnstile verifications skip silently (dev safety)
# AND the affected forms log a one-time warning. DO NOT ship to production
# without both keys set in Vercel env.
# Cloudflare test keys for local dev (both produce a token that passes):
#   Site key:   1x00000000000000000000AA
#   Secret key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- CRMLS / Trestle MLS Data (Real Estate) ---------------------------------
# OAuth2 client credentials — same values used in menke-real-estate.
# Set in Vercel: Project Settings → Environment Variables → Production.
# TRESTLE_BASE_URL       (e.g. https://api-prod.corelogic.com/trestle/odata)
# TRESTLE_CLIENT_ID      (your Trestle vendor client ID)
# TRESTLE_CLIENT_SECRET  (your Trestle vendor client secret)
# TRESTLE_OFFICE_MLS_ID  (office MLS ID — for filtering)
# TRESTLE_AGENT_MLS_ID   (agent MLS ID — for filtering)
# Used server-side only; never exposed to the browser.

# --- Stripe Payments -------------------------------------------------------
# Get keys from: https://dashboard.stripe.com/apikeys
# Use TEST keys (pk_test_ / sk_test_) for local development.
# Use LIVE keys (pk_live_ / sk_live_) in Vercel (Production scope).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...     # From: stripe listen --forward-to localhost:3000/api/stripe/webhook

# Price IDs from Stripe Dashboard → Product Catalog
# Create two products in Stripe:
#   - "Featured Listing - Monthly": $29/month recurring
#   - "Featured Listing - Yearly": $199/year recurring
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# Your app's public URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://moval.living


# --- Moval.Living <-> HeadsUpCRM claim bridge (added 2026-09-14) ---
# Shared HMAC-SHA256 secret for the bidirectional claim-status sync
# with HeadsUpCRM. MUST match the value in:
#   - headsupcrm/.env.local          (CRM inbound webhook + daily cron)
#   - headsupcrm/.env on Railway     (the same cron)
#   - moval-living/.env on Vercel    (this file - outbound webhooks +
#     inbound cron GETs)
# Generate once with: openssl rand -hex 32, then paste on all three.
# If unset here: outbound webhooks log a warning and skip (page still
# works); the CRM's daily cron still signs its GET and this side
# verifies it. Inbound webhooks from the CRM do NOT exist today, so the
# failure mode is "we silently fail to push claim updates to the CRM".
MOVAL_CLAIM_SHARED_SECRET=

# Apex URL of the HeadsUpCRM deployment (no trailing slash). The CRM's
# daily cron hits our /api/external/moval-business-claimed-since
# endpoint and we return rows from here, but we POST claim events to
# THIS URL on /claim/complete.
CRM_BASE_URL=https://headsupcrm.com
