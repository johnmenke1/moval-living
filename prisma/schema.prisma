// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  tagline          String?
  description      String    @db.Text
  categoryId       String
  category         Category  @relation(fields: [categoryId], references: [id])
  tier             Tier      @default(FREE)
  status           Status    @default(PENDING)
  isBestOfWinner  Boolean  @default(false)
  bestOfTags       String[] @default([])

  // Contact
  email            String?
  phone            String?
  website          String?
  address          String
  city             String    @default("Moreno Valley")
  state            String    @default("CA")
  zip              String
  latitude         Float?
  longitude        Float?

  // Media
  logo             String?
  coverImage       String?
  photos           String[]  // Array of photo URLs

  // Social
  facebook         String?
  instagram        String?
  yelp             String?
  googleBusiness   String?    // Google Place ID (from Google Business Profile)
  googleRating     Float?     // Cached average rating from Google (0-5)
  googleReviewCount Int?       // Cached review count from Google

  // Hours stored as JSON: { mon: { open: "9:00 AM", close: "5:00 PM", closed: false }, ... }
  hours            Json?

  // SEO
  metaTitle        String?
  metaDescription  String?

  // Coupon/Deal
  hasCoupon        Boolean   @default(false)
  coupon          Json?     // { headline: string, description: string, code?: string, expiresAt?: string }

  // Stripe
  stripeCustomerId           String?   @unique
  stripeSubscriptionId       String?
  subscriptionStatus        String?    // 'active' | 'past_due' | 'canceled' | 'trialing'
  subscriptionCurrentPeriodEnd DateTime?

  // Relations
  owner           Owner?     @relation(fields: [ownerId], references: [id])
  ownerId         String?    @unique
  claimToken      String?    @unique  // One-time token to claim ownership
  claimExpiresAt  DateTime?            // Token expires after 7 days
  reviews         Review[]
  socialPosts     SocialPost[]
  bestOfNominees  BestOfNominee[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([isBestOfWinner])
  @@index([tier])
  @@index([city])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String  // Lucide icon name e.g. "Utensils", "Car", "Stethoscope"
  image       String?    // Optional category hero image URL
  businesses  Business[]
  createdAt   DateTime   @default(now())

  @@index([slug])
}

model Owner {
  id            String    @id @default(cuid())
  role          UserRole  @default(USER)
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   // Set when user creates/updates a password
  resetToken    String?   @unique // Hashed token for password reset
  resetExpires  DateTime? // Expiry time for reset token
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  business      Business?
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token     String? @db.Text
  expires_at       Int?
  token_type       String?
  scope             String?
  id_token         String? @db.Text
  session_state    String?
  owner            Owner   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  owner        Owner    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String?
  rating      Int       // 1-5
  content     String    @db.Text
  response    String?   @db.Text  // Owner's response
  flagged     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId])
  @@index([flagged])
}

model SocialPost {
  id           String       @id @default(cuid())
  platform     Platform     // INSTAGRAM or FACEBOOK
  postUrl      String
  caption      String?      @db.Text
  mediaUrl     String?      // Primary image/video URL (extracted from post)
  thumbnailUrl String?      // Fallback thumbnail when mediaUrl is a video (poster frame)
  authorName   String?
  authorAvatar String?
  status       PostStatus   @default(PENDING)
  // The date of the actual event/opportunity (not when the post was submitted).
  // Nullable so casual social posts without an event date can still be submitted.
  // When null, the post renders in the "Posts" view but not the calendar timeline.
  eventDate    DateTime?
  // Optional end date for multi-day events. Same semantics as eventDate.
  eventEndDate DateTime?
  // Optional link to a business (if the event/opportunity is from that business)
  businessId   String?
  business     Business?    @relation(fields: [businessId], references: [id], onDelete: SetNull)
  submittedBy  String?      // Owner's email or name
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([businessId])
  @@index([eventDate])
}

enum Platform {
  INSTAGRAM
  FACEBOOK
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Tier {
  FREE
  FEATURED
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

// ── Curated BestOf System (no algorithmic scoring) ──────────────────────────
// BestOfCategory = an award title (e.g. "Best Coffee", "Best Tacos")
// BestOfNominee  = a business nominated for a category (winner flag set by admin)

model BestOfCategory {
  id               String            @id @default(cuid())
  name             String            // "Best Coffee", "Best Tacos", "Food & Hospitality"
  slug             String            @unique
  description      String?
  icon             String?           // Lucide icon name e.g. "Coffee", "Taco"
  tagHints         String[]          // e.g. ["coffee-house", "cafe"] — admin suggestion hints only
  published        Boolean           @default(false)
  isSection        Boolean           @default(false)  // true = section header (visual only, not a clickable card)
  imageUrl         String?           // cover image for category block (or section header)
  // Parent category for sub-categories. Null = top-level parent category (e.g. "Coffee", "Real Estate")
  parentCategoryId String?
  parentCategory   BestOfCategory?   @relation("BestOfCategoryHierarchy", fields: [parentCategoryId], references: [id])
  subCategories    BestOfCategory[]   @relation("BestOfCategoryHierarchy")
  nominees         BestOfNominee[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([slug])
  @@index([published])
  @@index([parentCategoryId])
  @@index([isSection])
}

model BestOfNominee {
  id           String        @id @default(cuid())
  category     BestOfCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId   String
  business     Business      @relation(fields: [businessId], references: [id])
  businessId   String
  winner       Boolean       @default(false)  // admin marks the #1 pick
  notes        String?       // optional editorial note e.g. "Known for cold brew"
  displayOrder Int           @default(0)     // admin-controlled ordering within category
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([categoryId, businessId])
  @@index([categoryId])
  @@index([winner])
}
