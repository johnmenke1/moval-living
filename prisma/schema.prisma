// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  tagline          String?
  description      String    @db.Text
  categoryId       String
  category         Category  @relation(fields: [categoryId], references: [id])
  tier             Tier      @default(FREE)
  status           Status    @default(PENDING)
  isBestOfWinner   Boolean   @default(false)
  bestOfTags       String[]  @default([])

  // Expert Partner program ($197/mo or $997/yr — one slot per category)
  isExpertPartner      Boolean   @default(false)
  expertPartnerSlug    String?   @unique
  foundingPartnerSince DateTime?
  liveQaZoomUrl        String?
  liveQaNextDate       DateTime?
  ghlCompanyId         String?   @unique           // GHL Companies endpoint mapping (private integration token)

  // Contact
  email            String?
  phone            String?
  website          String?
  address          String
  city             String    @default("Moreno Valley")
  state            String    @default("CA")
  zip              String
  latitude         Float?
  longitude        Float?

  // Media
  logo             String?
  coverImage       String?
  photos           String[]

  // Social
  facebook         String?
  instagram        String?
  yelp             String?
  googleBusiness   String?
  googleRating     Float?
  googleReviewCount Int?

  hours            Json?

  // SEO
  metaTitle        String?
  metaDescription  String?

  // Coupon/Deal
  hasCoupon        Boolean   @default(false)
  coupon           Json?

  // Stripe
  stripeCustomerId           String?   @unique
  stripeSubscriptionId       String?
  subscriptionStatus         String?
  subscriptionCurrentPeriodEnd DateTime?

  // Relations
  owner              Owner?             @relation(fields: [ownerId], references: [id])
  ownerId            String?            @unique
  claimToken         String?            @unique
  claimExpiresAt     DateTime?
  reviews            Review[]
  socialPosts        SocialPost[]
  bestOfNominees     BestOfNominee[]
  guestAuthors       GuestAuthor[]
  expertPartnerLeads ExpertPartnerLead[]
  expertPartnerStats ExpertPartnerStat[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([isBestOfWinner])
  @@index([tier])
  @@index([city])
  @@index([isExpertPartner])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String
  image       String?
  businesses  Business[]
  createdAt   DateTime   @default(now())

  @@index([slug])
}

model Owner {
  id            String    @id @default(cuid())
  role          UserRole  @default(USER)
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  resetToken    String?   @unique
  resetExpires  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  business      Business?
  guestAuthors  GuestAuthor[]
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  owner             Owner   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  owner        Owner    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String?
  rating      Int
  content     String    @db.Text
  response    String?   @db.Text
  flagged     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId])
  @@index([flagged])
}

model SocialPost {
  id           String       @id @default(cuid())
  platform     Platform
  postUrl      String
  caption      String?      @db.Text
  mediaUrl     String?
  thumbnailUrl String?
  authorName   String?
  authorAvatar String?
  status       PostStatus   @default(PENDING)
  eventDate    DateTime?
  eventEndDate DateTime?
  businessId   String?
  business     Business?    @relation(fields: [businessId], references: [id], onDelete: SetNull)
  submittedBy  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([businessId])
  @@index([eventDate])
}

enum Platform {
  INSTAGRAM
  FACEBOOK
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Tier {
  FREE
  FEATURED
  EXPERT_PARTNER
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

// ── Curated BestOf System (no algorithmic scoring) ──────────────────────────

model BestOfCategory {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String?
  icon             String?
  tagHints         String[]
  published        Boolean           @default(false)
  isSection        Boolean           @default(false)
  imageUrl         String?
  parentCategoryId String?
  parentCategory   BestOfCategory?   @relation("BestOfCategoryHierarchy", fields: [parentCategoryId], references: [id])
  subCategories    BestOfCategory[]  @relation("BestOfCategoryHierarchy")
  nominees         BestOfNominee[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([slug])
  @@index([published])
  @@index([parentCategoryId])
  @@index([isSection])
}

model BestOfNominee {
  id           String         @id @default(cuid())
  category     BestOfCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId   String
  business     Business       @relation(fields: [businessId], references: [id])
  businessId   String
  winner       Boolean        @default(false)
  notes        String?
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([categoryId, businessId])
  @@index([categoryId])
  @@index([winner])
}

// ── Guest Author / Guest Post ─────────────────────────────────────────────

model GuestAuthor {
  id              String   @id @default(cuid())
  slug            String   @unique
  displayName     String
  title           String?
  bio             String   @db.Text
  photoUrl        String?

  personalSiteUrl String?
  companyName     String?
  companyUrl      String?
  linkedinUrl     String?
  twitterUrl      String?
  facebookUrl     String?
  instagramUrl    String?

  businessId      String?
  business        Business? @relation(fields: [businessId], references: [id])
  ownerId         String?
  owner           Owner?    @relation(fields: [ownerId], references: [id])

  postsThisPeriod Int       @default(0)
  periodStartedAt DateTime  @default(now())
  lastPostedAt    DateTime?

  isActive        Boolean   @default(true)
  posts           GuestPost[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
  @@index([isActive])
}

// ── Post Types ────────────────────────────────────────────────────────────────
// LIFE       = "Life in MoVal" — John's editorial voice (no GuestAuthor needed)
// GUEST      = External expert post (requires GuestAuthor)
// OUTING     = Live Curiously outing photo-essay (no GuestAuthor)
// SPOTLIGHT  = Business video short (optional GuestAuthor)

model GuestPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  postType        String   @default("GUEST")
  title           String
  excerpt         String   @db.Text
  body            String   @db.Text
  heroImageUrl    String?
  status          String   @default("draft")
  submittedAt     DateTime?
  scheduledFor    DateTime?
  publishedAt     DateTime?
  rejectionReason String?
  authorId        String?
  editorNotes     String?
  metaTitle       String?
  metaDescription String?
  author          GuestAuthor? @relation(fields: [authorId], references: [id], onDelete: Cascade)

  spotifyTrack1   String?
  spotifyTrack2   String?

  faqItems        Json?    @default("[]")
  outingPhotos    Json     @default("[]")
  youtubeVideoId  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([authorId, publishedAt(sort: Desc)])
  @@index([postType, publishedAt(sort: Desc)])
}

// ── Expert Partner Program ─────────────────────────────────────────────────
// Moreno Valley Expert Partner ($197/mo or $997/yr) — one business per
// category. Leads captured on /partners/[slug] are stored locally AND
// forwarded to GoHighLevel (sub-account per partner in v2).

model ExpertPartnerLead {
  id           String   @id @default(cuid())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId   String

  name         String
  email        String
  phone        String?
  message      String   @db.Text

  sourceIp     String?
  userAgent    String?  @db.Text

  contacted    Boolean  @default(false)
  contactedAt  DateTime?
  notes        String?  @db.Text

  ghlContactId String?
  ghlSyncedAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId, createdAt(sort: Desc)])
  @@index([contacted])
}

model ExpertPartnerStat {
  id              String   @id @default(cuid())
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId      String

  month           DateTime

  storyViews      Int      @default(0)
  newsletterOpens Int      @default(0)
  listingClicks   Int      @default(0)

  notes           String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([businessId, month])
  @@index([businessId, month(sort: Desc)])
}