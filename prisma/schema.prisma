// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  tagline        String?
  description    String   @db.Text
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  tier           Tier     @default(FREE)
  status         Status   @default(PENDING)
  isBestOfWinner Boolean  @default(false)
  bestOfTags     String[] @default([])

  // Expert Partner program ($197/mo or $997/yr — one slot per category)
  isExpertPartner      Boolean   @default(false)
  expertPartnerSlug    String?   @unique
  foundingPartnerSince DateTime?
  foundingPartnerRate  Boolean   @default(false) // locks legacy $997/yr price; live DB has 506 rows
  ghlLocationId        String? // live DB has 0 rows; declared to prevent silent drop
  liveQaZoomUrl        String?
  liveQaNextDate       DateTime?
  ghlCompanyId         String?   @unique // GHL Companies endpoint mapping (private integration token)
  ghlContactId         String?   @unique // GHL Contacts endpoint mapping (private integration token)

  // Contact
  email     String?
  phone     String?
  website   String?
  address   String
  city      String  @default("Moreno Valley")
  state     String  @default("CA")
  zip       String
  latitude  Float?
  longitude Float?

  // Media
  logo       String?
  coverImage String?
  photos     String[]

  // Social
  facebook          String?
  instagram         String?
  yelp              String?
  googleBusiness    String?
  googleRating      Float?
  googleReviewCount Int?

  hours Json?

  // SEO
  metaTitle       String?
  metaDescription String?

  // CAN-SPAM / 10DLC / TCPA consent (recorded at submit-time, before claim)
  submitterEmailOptIn Boolean   @default(false)
  submitterSmsOptIn   Boolean   @default(false)
  submitterConsentAt  DateTime?

  // Languages & Chamber affiliations (badges shown on listing cards)
  seHablaEspanol        Boolean @default(false) // owner-toggleable in claim + edit
  chamberMember         Boolean @default(false) // Moreno Valley Chamber of Commerce — admin-only
  hispanicChamberMember Boolean @default(false) // MV Hispanic Chamber of Commerce — admin-only

  // Coupon/Deal
  hasCoupon Boolean @default(false)
  coupon    Json?

  // Stripe
  stripeCustomerId             String?   @unique
  stripeSubscriptionId         String?
  subscriptionStatus           String?
  subscriptionCurrentPeriodEnd DateTime?

  // Relations
  owner              Owner?              @relation(fields: [ownerId], references: [id])
  ownerId            String?             @unique
  claimToken         String?             @unique
  claimExpiresAt     DateTime?
  // ── Lifecycle timestamps (for /api/public/live-activity ticker) ────────
  // claimedAt: first time ownerId got set. FeaturedAt: first time tier
  // flipped to FEATURED. Both nullable, both populated by the places that
  // currently write those fields. Used to surface "X just claimed…" and
  // "X upgraded to Featured…" events on the homepage. Stable once set —
  // never overwritten on subsequent updates.
  claimedAt          DateTime?
  featuredAt         DateTime?
  reviews            Review[]
  socialPosts        SocialPost[]
  bestOfNominees     BestOfNominee[]
  bestOfNominations  BestOfNomination[]
  guestAuthors       GuestAuthor[]
  expertPartnerLeads ExpertPartnerLead[]
  expertPartnerStats ExpertPartnerStat[]
  audits             BusinessAudit[]
  events             Event[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([isBestOfWinner])
  @@index([tier])
  @@index([city])
  @@index([isExpertPartner])
  // Live DB already has these indexes (added by a sibling subagent via
  // direct DDL but never committed to schema). Keep them in sync so the
  // ticker query that filters by claimedAt/featuredAt stays fast.
  @@index([claimedAt])
  @@index([featuredAt])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String
  image       String?
  businesses  Business[]
  createdAt   DateTime   @default(now())

  @@index([slug])
}

model Owner {
  id               String        @id @default(cuid())
  role             UserRole      @default(USER)
  name             String?
  email            String        @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  resetToken       String?       @unique
  resetExpires     DateTime?
  phone            String? // for future SMS opt-in
  // CAN-SPAM / 10DLC / TCPA consent tracking
  emailOptIn       Boolean       @default(false)
  smsOptIn         Boolean       @default(false)
  emailConsentAt   DateTime?
  smsConsentAt     DateTime?
  smsConsentSource String? // e.g. 'claim-form', 'submit-form', 'landing-page'
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  accounts         Account[]
  sessions         Session[]
  business         Business?
  guestAuthors     GuestAuthor[]
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  owner             Owner   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  owner        Owner    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String?
  rating      Int
  content     String   @db.Text
  response    String?  @db.Text
  flagged     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
  @@index([flagged])
}

model SocialPost {
  id           String     @id @default(cuid())
  platform     Platform
  postUrl      String
  caption      String?    @db.Text
  mediaUrl     String?
  thumbnailUrl String?
  authorName   String?
  authorAvatar String?
  status       PostStatus @default(PENDING)
  eventDate    DateTime?
  eventEndDate DateTime?
  businessId   String?
  business     Business?  @relation(fields: [businessId], references: [id], onDelete: SetNull)
  submittedBy  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([businessId])
  @@index([eventDate])
}

// ── Events System ─────────────────────────────────────────────────────────
// Submission is what humans (and Emma's regional scan) write; Event is what
// the public /events page renders after admin approval. See migration
// 20260816000000_add_event_submission for the SQL that backs this.

enum VenueTag {
  FOX_RIVERSIDE
  RIVERSIDE_MUNICIPAL_AUDITORIUM
  RIVERSIDE_CONVENTION_CENTER
  UCR
  CBU
  RIVERSIDE_ART_MUSEUM
  RIVERSIDE_METROPOLITAN_MUSEUM
  REDLANDS_BOWL
  REDLANDS_THEATER_FESTIVAL
  MOVAL_HIGH_SCHOOL
  OTHER
}

enum EventTier {
  STANDARD
  HONORABLE_MENTION
  HERO
}

enum EventCategory {
  // SPORTS was split into three specific categories in 2026-08 to give
  // Moreno Valley residents more targeted filters. SPORTS itself was
  // removed from new usage; existing rows were migrated to HS_SPORTS or
  // COLLEGE_SPORTS in migration 20260816000000_split_sports_and_add_political.
  HS_SPORTS         // High school athletics — CIF, MVUSD, etc.
  COLLEGE_SPORTS    // College athletics — UCR, CBU, etc.
  LEAGUE_SPORTS     // Adult leagues, club sports, rec leagues
  POLITICAL         // Town halls, candidate forums, ballot events, protests
  MUSIC
  ARTS
  EDUCATIONAL
  FUNDRAISERS
  COMMUNITY
  FAMILY
  FOOD_DRINK
  HOLIDAY_CELEBRATIONS
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  DUPLICATE
}

enum SubmissionSource {
  INSTAGRAM
  FACEBOOK
  OTHER
}

model Submission {
  id                 String           @id @default(cuid())
  slug               String           @unique
  sourceUrl          String
  sourcePlatform     SubmissionSource
  sourceAuthorHandle String?
  sourceAuthorUrl    String?
  sourceThumbnailUrl String?
  sourcePostCaption  String?          @db.Text
  sourceCapturedAt   DateTime?
  thumbnailUrl       String?
  title              String
  startsAt           DateTime
  endsAt             DateTime?
  venueName          String?
  submittedById      String?
  submitterNote      String?          @db.Text
  status             SubmissionStatus @default(PENDING)
  reviewedById       String?
  reviewedAt         DateTime?
  rejectionReason    String?
  promotedToEventId  String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  promotedToEvent Event? @relation("SubmissionToEvent", fields: [promotedToEventId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([startsAt])
  @@index([createdAt])
}

model Event {
  id                      String    @id @default(cuid())
  slug                    String    @unique
  title                   String
  description             String?   @db.Text
  startsAt                DateTime
  endsAt                  DateTime?
  venueName               String?
  venueTag                VenueTag  @default(OTHER)
  category                EventCategory?
  address                 String?
  city                    String?
  state                   String?
  zip                     String?
  heroImageUrl            String?
  ticketUrl               String?
  isFree                  Boolean   @default(false)
  // Mirrors Business.seHablaEspanol. When true, the event is primarily
  // delivered in Spanish (or bilingual). Surfaced as a public filter chip
  // and a badge on the event card.
  esEnEspanol             Boolean   @default(false)
  tier                    EventTier @default(STANDARD)
  source                  String
  sourceUrl               String?
  sourceAuthorHandle      String?
  sourceAuthorUrl         String?
  sourcePostExcerpt       String?   @db.Text

  // Optional link to a local Business listing. When set, the event card
  // surfaces the venueName as a click-through to /business/[slug]. The
  // back-relation on Business.events lets the business page list its events.
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  originatingSubmissionId String?
  submittedById           String?
  reviewedById            String?
  reviewedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  submissions Submission[] @relation("SubmissionToEvent")

  @@index([startsAt])
  @@index([tier])
  @@index([venueTag])
  @@index([city])
  @@index([category])
  @@index([businessId])
  @@index([esEnEspanol])
}

enum Platform {
  INSTAGRAM
  FACEBOOK
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Tier {
  FREE
  FEATURED
  EXPERT_PARTNER
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

// ── Curated BestOf System (no algorithmic scoring) ──────────────────────────

model BestOfCategory {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  description      String?
  icon             String?
  tagHints         String[]
  published        Boolean          @default(false)
  isSection        Boolean          @default(false)
  imageUrl         String?
  parentCategoryId String?
  parentCategory   BestOfCategory?  @relation("BestOfCategoryHierarchy", fields: [parentCategoryId], references: [id])
  subCategories    BestOfCategory[] @relation("BestOfCategoryHierarchy")
  nominees         BestOfNominee[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([slug])
  @@index([published])
  @@index([parentCategoryId])
  @@index([isSection])
}

model BestOfNominee {
  id           String         @id @default(cuid())
  category     BestOfCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId   String
  business     Business       @relation(fields: [businessId], references: [id])
  businessId   String
  winner       Boolean        @default(false)
  notes        String?
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([categoryId, businessId])
  @@index([categoryId])
  @@index([winner])
}

// ── Public BestOf Nominations ─────────────────────────────────────────────
// Submitted by any visitor (no auth) via /submit/best-of. Lands PENDING,
// reviewed by admin in the dashboard "Best-Of Nominations" tab. Approval
// promotes the suggestion into a BestOfCategory + BestOfNominee. Rejection
// keeps the row for record-keeping (and as market-research signal — what
// categories people are asking for).
//
// Captures CAN-SPAM/10DLC/TCPA consent at submit-time (same pattern as
// Business.submitterEmailOptIn / Owner.emailOptIn). Mirrors the nominator
// into GoHighLevel as a Contact with tag 'community-member' (broad enough
// to reuse for guest posts, claims, etc.) and source 'best-of-nomination'.

enum BestOfNominationStatus {
  PENDING
  APPROVED
  REJECTED
}

model BestOfNomination {
  id           String    @id @default(cuid())
  // Free-text — may match an existing Business (businessId set below) or be
  // a brand-new suggestion the admin hasn't listed yet.
  businessName String
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  // Free-text — always captured even if a matching category exists. Lets the
  // admin see how the nominator phrased it, and surfaces category requests.
  categoryName String

  nominatorName  String
  nominatorEmail String
  reason         String @db.Text

  status BestOfNominationStatus @default(PENDING)

  // Captured consents (CAN-SPAM / 10DLC / TCPA)
  emailOptIn     Boolean   @default(false)
  smsOptIn       Boolean   @default(false) // always false — public form doesn't collect phone
  emailConsentAt DateTime?
  consentSource  String? // e.g. 'best-of-nomination-form'

  // GHL mirror
  ghlContactId String?   @unique
  ghlSyncedAt  DateTime?

  // Source capture for spam/abuse review
  sourceIp  String?
  userAgent String? @db.Text

  // Admin actions
  reviewedBy        String? // Owner.id of the reviewing admin
  reviewedAt        DateTime?
  rejectionReason   String?   @db.Text
  adminNotes        String?   @db.Text
  promotedNomineeId String?   @unique // FK to BestOfNominee.id if promoted on approve

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([nominatorEmail])
  @@index([businessId])
}

// ── Guest Author / Guest Post ─────────────────────────────────────────────

model GuestAuthor {
  id          String  @id @default(cuid())
  slug        String  @unique
  displayName String
  title       String?
  bio         String  @db.Text
  photoUrl    String?

  personalSiteUrl String?
  companyName     String?
  companyUrl      String?
  linkedinUrl     String?
  twitterUrl      String?
  facebookUrl     String?
  instagramUrl    String?

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
  ownerId    String?
  owner      Owner?    @relation(fields: [ownerId], references: [id])

  postsThisPeriod Int       @default(0)
  periodStartedAt DateTime  @default(now())
  lastPostedAt    DateTime?

  isActive Boolean     @default(true)
  posts    GuestPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
}

// ── Post Types ────────────────────────────────────────────────────────────────
// LIFE       = "Life in MoVal" — John's editorial voice (no GuestAuthor needed)
// GUEST      = External expert post (requires GuestAuthor)
// OUTING     = Live Curiously outing photo-essay (no GuestAuthor)
// SPOTLIGHT  = Business video short (optional GuestAuthor)

model GuestPost {
  id              String       @id @default(cuid())
  slug            String       @unique
  postType        String       @default("GUEST")
  title           String
  excerpt         String       @db.Text
  body            String       @db.Text
  heroImageUrl    String?
  status          String       @default("draft")
  submittedAt     DateTime?
  scheduledFor    DateTime?
  publishedAt     DateTime?
  rejectionReason String?
  authorId        String?
  editorNotes     String?
  metaTitle       String?
  metaDescription String?
  author          GuestAuthor? @relation(fields: [authorId], references: [id], onDelete: Cascade)

  spotifyTrack1 String?
  spotifyTrack2 String?

  faqItems       Json?   @default("[]")
  outingPhotos   Json    @default("[]")
  youtubeVideoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([authorId, publishedAt(sort: Desc)])
  @@index([postType, publishedAt(sort: Desc)])
}

// ── Expert Partner Program ─────────────────────────────────────────────────
// Moreno Valley Expert Partner ($197/mo or $997/yr) — one business per
// category. Leads captured on /partners/[slug] are stored locally AND
// forwarded to GoHighLevel (sub-account per partner in v2).

model ExpertPartnerLead {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  name    String
  email   String
  phone   String?
  message String  @db.Text

  sourceIp  String?
  userAgent String? @db.Text

  contacted   Boolean   @default(false)
  contactedAt DateTime?
  notes       String?   @db.Text

  ghlContactId String?
  ghlSyncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, createdAt(sort: Desc)])
  @@index([contacted])
}

model ExpertPartnerStat {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  month DateTime

  storyViews      Int @default(0)
  newsletterOpens Int @default(0)
  listingClicks   Int @default(0)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, month])
  @@index([businessId, month(sort: Desc)])
}

// ── Web Audit ────────────────────────────────────────────────────────────
// Per-business web-presence audit data, populated by scripts/web-audit.mjs.
// One row per business (unique businessId). Re-running the script upserts
// and refreshes auditedAt — idempotent, designed for periodic re-audit.
//
// Signals extracted from the Business.website URL by parsing the HTML:
//   - httpStatus / finalUrl: did the site respond, and where did it land
//                            (catches http→https redirects, www→apex, etc.)
//   - hasSsl:                 finalUrl starts with https://
//   - hasViewportMeta:        <meta name="viewport"> present (mobile-friendly proxy)
//   - hasH1:                  at least one <h1> on the homepage
//   - hasMetaDescription:     <meta name="description"> with non-empty content
//   - hasContactForm:         at least one <form> with an <input> or <textarea>
//   - hasGoogleAnalytics:     gtag.js / analytics.js / GA snippet in HTML
//   - hasGoogleTagManager:    googletagmanager.com script in HTML
//   - copyrightYear:          the year in the copyright line (e.g. "© 2019 Acme")
//                             null if no copyright found
//   - hasStructuredData:      any <script type="application/ld+json"> or Microdata
//   - pageLoadMs:             end-to-end fetch time, useful for "is it slow"
//   - contentLength:          response body size in bytes
//   - rawHtml:                first 50KB of response body (debug aid, capped)
// ── BusinessAudit (formerly WebAudit) ─────────────────────────────────────
// Per-audit snapshot of a Business's website health. Supports re-audit
// history: every run inserts a new row so we can show score trends over
// time and detect improvements after we help a business upgrade.
//
// Signal sources:
//   - Direct HEAD/GET probes (SSL, meta tags, scripts, sitemaps) — fast,
//     cheap, runs against every business
//   - Tavily Extract (emails, phones, copyright year, content depth,
//     deprecated-looking HTML) — paid credits, 1 per business per audit
//
// Drives:
//   - Admin diagnostics panel (top/bottom scores, re-audit history)
//   - Public site health badge on /business/[slug]
//   - GHL mirror (3 custom fields: summary, score, date)
//
// Does NOT drive outreach — that requires explicit consent + a separate
// "outreach campaign" workflow (see conversation history).
model BusinessAudit {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  auditedAt DateTime @default(now())

  httpStatus    Int?
  finalUrl      String?
  error         String? @db.Text
  pageLoadMs    Int?
  contentLength Int?

  // ── Infrastructure (5) ────────────────────────────────────────────────
  hasSsl           Boolean @default(false)
  isMobileFriendly Boolean @default(false)
  siteLoads        Boolean @default(false)

  // ── SEO basics (8) ────────────────────────────────────────────────────
  hasTitle           Boolean @default(false)
  hasMetaDescription Boolean @default(false)
  hasSingleH1        Boolean @default(false)
  hasSitemap         Boolean @default(false)
  hasRobotsTxt       Boolean @default(false)
  hasSchemaOrg       Boolean @default(false)
  hasOpenGraph       Boolean @default(false)
  hasAltTextCoverage Boolean @default(false)

  // ── Conversion (3) ────────────────────────────────────────────────────
  hasContactForm  Boolean @default(false)
  hasVisibleEmail Boolean @default(false)
  foundEmail      String?
  foundPhone      String?

  // ── Analytics (3) ─────────────────────────────────────────────────────
  hasGoogleAnalytics  Boolean @default(false)
  hasGoogleTagManager Boolean @default(false)
  hasMetaPixel        Boolean @default(false)

  // ── Freshness (3) ─────────────────────────────────────────────────────
  copyrightYear     Int?
  hasDeprecatedHtml Boolean @default(false)
  hasBlog           Boolean @default(false)

  // ── Composite ─────────────────────────────────────────────────────────
  score Int @default(0)

  // ── Source data for re-processing ─────────────────────────────────────
  rawHtml    String? @db.Text
  rawSignals Json?

  @@index([businessId])
  @@index([score])
  @@index([auditedAt])
}


// ── Parks & Recreation (added 2026-08-17) ──────────────────────────────────
// City of Moreno Valley parks + Cottonwood Golf Center + Conference & Rec Center.
// Distinct from Business because parks are not commercial entities, don't go
// through the chamber/claim flow, and use a different amenity vocabulary.
model Park {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  type          ParkType
  googlePlaceId String?

  // Address (denormalized for fast map rendering without Geo lookup)
  address String?
  city    String  @default("Moreno Valley")
  state   String  @default("CA")
  zip     String?

  // Coordinates for map pins
  latitude  Float?
  longitude Float?

  // Contact
  phone   String?
  website String?

  // Weekly hours (JSON: { mon: [{open, close}], ... }) — null = "call for hours"
  hoursJson Json?

  // Amenity tags (free-text but constrained via lib/park-amenities constant)
  // Examples: "pump_track", "skate_park", "water_play", "tennis", "dog_park",
  //           "basketball", "picnic", "playground", "disc_golf", "splash_pad",
  //           "restrooms", "walking_trails", "bbq", "wheelchair_accessible"
  amenities String[] @default([])

  // Photos (Vercel Blob URLs, captured via scripts/capture-park-photos.mts)
  heroPhotoUrl String?
  photoUrls    String[] @default([])

  // Editorial
  blurb       String?
  description String?

  // Curation
  featured Boolean @default(false)
  isActive Boolean @default(true)

  // Google reputation (mirrors Business.googleRating/googleReviewCount pattern)
  googleRating      Float?
  googleReviewCount Int?

  // Ops
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([slug])
  @@index([featured])
}

enum ParkType {
  PARK
  GOLF
  REC_CENTER
}
