  "narrative": {
    "northStar": "The Valley Storefront",
    "overview": "The site behaves like a well-kept main street: bright, inviting, and a little showy about local pride. Deep midnight navy provides the frame, vivid teal is the welcome mat, and coral and gold are the window signage that says \"look here.\"",
    "keyCharacteristics": [
      "Navy-and-teal base with coral and gold as deliberate accents",
      "Serif headlines over a sans body",
      "Rounded (12-16px) cards, buttons and inputs",
      "Ambient, tinted shadows and lift-on-hover states",
      "Gradient fills on primary actions; mesh and midnight gradients for hero bands",
      "Mobile-first, content width capped at 80rem"
    ],
    "rules": [
      {
        "name": "The Featured Coral Rule",
        "body": "Coral marks paid or featured placement and the single most important action on a screen. If everything is coral, nothing is featured.",
        "section": "colors"
      },
      {
        "name": "The Midnight Frame Rule",
        "body": "Dark navy bands are for hero and campaign moments; content pages stay on Cool Mist and Paper White.",
        "section": "colors"
      },
      {
        "name": "The Serif-Heads Rule",
        "body": "All h1-h6 use Fraunces; all other text uses Inter. Never set body copy in the serif.",
        "section": "typography"
      },
      {
        "name": "The Lift-Not-Scale Rule",
        "body": "Hover raises elements with translateY and shadow; it never scales them, which shimmers text.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use Fraunces for every heading and Inter for everything else.",
      "Do keep teal as the default interactive color and reserve coral for featured items and the primary conversion.",
      "Do lift cards and buttons with translateY and shadow on hover.",
      "Do use Lucide icons for UI glyphs.",
      "Do use the shared tokens (`--color-*`, `.btn-*`, `.card`, `.input`) before inventing new ones."
    ],
    "donts": [
      "Don't scale elements on hover.",
      "Don't put body copy in the serif.",
      "Don't use coral or gold as large background fills on content pages.",
      "Don't introduce a second accent hue beyond coral and gold.",
      "Don't hard-code new hex values in components when a token exists."
    ]
  }
